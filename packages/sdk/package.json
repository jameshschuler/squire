{
  "name": "@jameshschuler/walkscape-sdk",
  "version": "0.0.1",
  "description": "Unofficial TypeScript client for the WalkScape Data API, with recipe helpers",
  "keywords": [
    "walkscape",
    "api",
    "sdk",
    "recipes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameshschuler/squire.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/jameshschuler/squire/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/jameshschuler/squire/issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "vitest": "^5.0.4"
  }
}
